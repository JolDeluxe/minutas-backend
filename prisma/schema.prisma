generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ───────────────────────────────────────────────

enum Rol {
  ADMIN
  GERENCIA
  JEFE
  COORDINADOR
}

enum Departamento {
  DISENO
  MARKETING
}

enum Estatus {
  ACTIVO
  INACTIVO
}

enum Area {
  DISENO
  MARKETING
  DIRECCION_MBC
  DIRECCION_CFI
  DIRECCION_ADJUNTA
  DIRECCION_TIENDAS
  DIRECCION_MKT
  DIRECCION_ALTA_CALIDAD
  OTRA
}

enum Prioridad {
  BAJA
  MEDIA
  ALTA
  CRITICA
}

enum TipoEntrada {
  SIN_ORGANIZAR
  TAREA
  RECORDATORIO
  POLITICA
  DESCARTADA
}

enum AlcanceRecordatorio {
  DEPARTAMENTO
  PERSONAL
}

enum EstadoTarea {
  PENDIENTE
  EN_REVISION
  CERRADA
  CANCELADA
  DESCARTADA
}

enum EstadoMinuta {
  PROGRAMADA
  EN_CURSO
  EN_ORGANIZACION
  ACTIVA
  CERRADA
  CANCELADA
}

enum EstadoMinutaExterna {
  ACTIVA
  CERRADA
  CANCELADA
}

enum TipoImagen {
  CAPTURA
  EVIDENCIA
}

enum TipoEventoEntrada {
  CAPTURA
  ACTUALIZACION
  REVISION
  FORMALIZACION
  ASIGNACION
  CAMBIO_ESTADO
  CIERRE
  DESCARTE
  COMENTARIO
  ADJUNTO
  NOTIFICACION
}

// ─── MODELOS ─────────────────────────────────────────────

model Usuario {
  id       Int     @id @default(autoincrement())
  nombre   String  @db.VarChar(100)
  username String  @unique @db.VarChar(60)
  email    String? @unique @db.VarChar(150)
  password String  @db.VarChar(255)
  imagen   String? @db.VarChar(500)

  rol    Rol     @default(COORDINADOR)
  estado Estatus @default(ACTIVO)

  departamento Departamento?
  linea        String?

  dummyClasificacion String?

  mustChangePassword Boolean @default(false)

  minutasCreadas        Minuta[]             @relation("MinutaCreador")
  minutasCerradas       Minuta[]             @relation("MinutaCerrador")
  minutasCanceladas     Minuta[]             @relation("MinutaCancelador")
  tareasCreadas         Tarea[]              @relation("TareaCreador")
  tareasOrganizadas     Tarea[]              @relation("TareaOrganizador")
  asignaciones          TareaAsignacion[]
  asignacionesCreadas   TareaAsignacion[]    @relation("TareaAsignador")
  historial             TareaHistorial[]
  notasGeneralesCreadas NotaGeneral[]        @relation("NotaGeneralCreador")
  notasEntradaCreadas   TareaNota[]          @relation("TareaNotaCreador")
  bitacoras             Bitacora[]
  refreshTokens         RefreshToken[]
  resetTokens           PasswordResetToken[]
  notificaciones        Notificacion[]
  pushSubscriptions     PushSubscription[]

  // Relaciones con Minutas Externas
  minutasExternasCreadas  MinutaExterna[]  @relation("MinutaExternaCreador")
  minutasExternasCerradas MinutaExterna[]  @relation("MinutaExternaCerrador")
  tareasExternasCreadas   TareaExterna[]   @relation("TareaExternaCreador")
  notasTareaExterna       TareaExternaNota[] @relation("TareaExternaNotaCreador")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([rol])
  @@index([estado])
}

model Minuta {
  id           Int          @id @default(autoincrement())
  titulo       String       @db.VarChar(200)
  lineaDefault String?
  departamento Departamento @default(DISENO)
  estado       EstadoMinuta @default(PROGRAMADA)

  fechaProgramada DateTime
  fechaRealizada  DateTime?

  creadoPorId Int
  creadoPor   Usuario @relation("MinutaCreador", fields: [creadoPorId], references: [id], onDelete: Restrict)

  cerradoPorId Int?
  cerradoPor   Usuario?  @relation("MinutaCerrador", fields: [cerradoPorId], references: [id], onDelete: SetNull)
  cerradoAt    DateTime?

  canceladoPorId Int?
  canceladoPor   Usuario?  @relation("MinutaCancelador", fields: [canceladoPorId], references: [id], onDelete: SetNull)
  canceladoAt    DateTime?

  minutaAnteriorId  Int?
  minutaAnterior    Minuta?  @relation("SiguienteAnterior", fields: [minutaAnteriorId], references: [id])
  minutasSiguientes Minuta[] @relation("SiguienteAnterior")

  tareas         Tarea[]
  notasGenerales NotaGeneral[] // <--- SE AGREGAN LOS POST-ITS A LA MINUTA

  // ── Resumen IA (Gemini) ───────────────────────────────────────────
  resumenTemas         String? @db.Text
  resumenAcuerdos      String? @db.Text
  resumenProximosPasos String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([creadoPorId])
  @@index([cerradoPorId])
  @@index([estado])
  @@index([fechaProgramada])
  @@index([fechaRealizada])
  @@index([lineaDefault])
  @@index([minutaAnteriorId])
}

// <--- NUEVO MODELO: POST-ITS GENERALES DE LA JUNTA
model NotaGeneral {
  id        Int     @id @default(autoincrement())
  contenido String  @db.Text
  imagenUrl String? @db.VarChar(500)
  publicId  String? @db.VarChar(300) // Para Cloudinary

  minutaId Int
  minuta   Minuta @relation(fields: [minutaId], references: [id], onDelete: Cascade)

  creadoPorId Int?
  creadoPor   Usuario? @relation("NotaGeneralCreador", fields: [creadoPorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([minutaId])
  @@index([creadoPorId])
}

/// Entrada Organizacional.
/// Se conserva el nombre tecnico `Tarea` por compatibilidad con los modulos actuales,
/// pero conceptualmente representa ideas, acuerdos, observaciones, seguimientos y
/// trabajo formalizado dentro de una minuta.
model Tarea {
  id           Int          @id @default(autoincrement())
  descripcion  String       @db.Text
  departamento Departamento @default(DISENO)

  // ── Campos de captura durante junta ─────────────────────
  area          Area    @default(DISENO)
  linea         String?
  clasificacion String

  // ── Clasificación post-junta ─────────────────────────────
  tipo TipoEntrada @default(SIN_ORGANIZAR)

  organizadoPorId Int?
  organizadoPor   Usuario?  @relation("TareaOrganizador", fields: [organizadoPorId], references: [id], onDelete: SetNull)
  organizadoAt    DateTime?

  // ── Solo aplica a tipo = TAREA ───────────────────────────
  estado           EstadoTarea?
  prioridad        Prioridad?
  fechaVencimiento DateTime?
  completadoAt     DateTime?
  cerradoAt        DateTime?

  // ── Solo aplica a tipo = RECORDATORIO ────────────────────
  alcanceRecordatorio AlcanceRecordatorio?

  // ── Notificación a área destino (solo ADMIN) ─────────────────
  notificadoAt DateTime?

  // ── Infraestructura ──────────────────────────────────────────
  pdfUrl String? @db.Text

  minutaId Int?
  minuta   Minuta? @relation(fields: [minutaId], references: [id], onDelete: SetNull)

  creadoPorId Int
  creadoPor   Usuario @relation("TareaCreador", fields: [creadoPorId], references: [id], onDelete: Restrict)

  imagenes       TareaImagen[]
  asignaciones   TareaAsignacion[]
  historial      TareaHistorial[]
  notas          TareaNota[]
  notificaciones Notificacion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([minutaId])
  @@index([tipo])
  @@index([estado])
  @@index([departamento])
  @@index([area])
  @@index([linea])
  @@index([clasificacion])
  @@index([fechaVencimiento])
  @@index([creadoPorId])
  @@index([organizadoPorId])
  @@index([minutaId, tipo])
  @@index([tipo, estado])
  @@index([departamento, tipo])
  @@index([alcanceRecordatorio])
}

// <--- NUEVO MODELO: ANEXOS DENTRO DE UNA TAREA
model TareaNota {
  id        Int      @id @default(autoincrement())
  contenido String   @db.Text
  imagenUrl String?  @db.VarChar(500)
  publicId  String?  @db.VarChar(300) // Para Cloudinary
  esEntrega Boolean  @default(false)

  tareaId Int
  tarea   Tarea @relation(fields: [tareaId], references: [id], onDelete: Cascade)

  creadoPorId Int?
  creadoPor   Usuario? @relation("TareaNotaCreador", fields: [creadoPorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([tareaId])
  @@index([creadoPorId])
}

model TareaAsignacion {
  id Int @id @default(autoincrement())

  tareaId Int
  tarea   Tarea @relation(fields: [tareaId], references: [id], onDelete: Cascade)

  usuarioId Int
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  asignadoPorId Int?
  asignadoPor   Usuario? @relation("TareaAsignador", fields: [asignadoPorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tareaId, usuarioId])
  @@index([tareaId])
  @@index([usuarioId])
  @@index([asignadoPorId])
}

model TareaImagen {
  id       Int    @id @default(autoincrement())
  url      String @db.VarChar(500)
  publicId String @db.VarChar(300) // Cloudinary public ID para poder eliminar
  orden    Int // 1, 2 o 3
  tipo     TipoImagen @default(CAPTURA)

  tareaId Int
  tarea   Tarea @relation(fields: [tareaId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([tareaId])
}

model TareaHistorial {
  id           Int               @id @default(autoincrement())
  tipo         TipoEventoEntrada @default(ACTUALIZACION)
  campo        String            @db.VarChar(100)
  valorAntes   String?           @db.Text
  valorDespues String?           @db.Text
  metadata     Json?

  tareaId Int
  tarea   Tarea @relation(fields: [tareaId], references: [id], onDelete: Cascade)

  usuarioId Int
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@index([tareaId])
  @@index([usuarioId])
  @@index([tipo])
}

// ─── INFRAESTRUCTURA (Reutilizados del sistema anterior) ──

model Bitacora {
  id       Int     @id @default(autoincrement())
  accion   String  @db.VarChar(100)
  detalles String? @db.Text

  usuarioId Int?
  usuario   Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([usuarioId])
  @@index([createdAt])
}

model RefreshToken {
  id          String @id @default(uuid())
  hashedToken String @db.VarChar(255)

  usuarioId Int
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  revoked   Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([usuarioId])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  token     String   @unique @db.VarChar(255)
  usuarioId Int
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([usuarioId])
}

// ─── NOTIFICACIONES ──────────────────────────────────────

enum TipoNotificacion {
  ENTRADA_CAPTURADA
  ENTRADA_ORGANIZADA
  ENTRADA_DESCARTADA
  TAREA_ASIGNADA
  TAREA_EN_REVISION
  TAREA_COMPLETADA
  TAREA_CERRADA
  TAREA_CANCELADA
  TAREA_MODIFICADA
  RECORDATORIO_ASIGNADO
  REVISION_PENDIENTE
  VENCIMIENTO_PROXIMO
  LINEA_CAMBIADA
  NUEVAS_ENTRADAS
}

model Notificacion {
  id        Int              @id @default(autoincrement())
  tipo      TipoNotificacion
  titulo    String           @db.VarChar(150)
  cuerpo    String           @db.Text
  leida     Boolean          @default(false)
  accionada Boolean          @default(false)

  usuarioId Int
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  tareaId Int?
  tarea   Tarea? @relation(fields: [tareaId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([usuarioId])
  @@index([leida])
  @@index([tareaId])
}

model PushSubscription {
  id       Int    @id @default(autoincrement())
  endpoint String @unique @db.VarChar(500)
  p256dh   String @db.VarChar(300)
  auth     String @db.VarChar(100)

  usuarioId    Int
  usuario      Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  lastSuccess  DateTime?
  failureCount Int       @default(0)

  createdAt DateTime @default(now())

  @@index([usuarioId])
}

// ─── MINUTAS EXTERNAS ─────────────────────────────────────────────────────────
// Sessiones de trabajo con departamentos distintos a Diseño y Marketing.
// Mantiene el mismo concepto de "minuta" pero enfocado en áreas externas.

model MinutaExterna {
  id     Int                 @id @default(autoincrement())
  tema   String              @db.VarChar(200)
  area   Area                @default(DIRECCION_MBC)
  // departamento = la sub-área / línea dentro del área (texto libre o valor de catálogo)
  departamento String?       @db.VarChar(100)

  objetivo    String?        @db.Text
  integrantes String?        @db.Text   // JSON array de strings (nombres)
  asistentes  String?        @db.Text   // JSON array de strings (nombres)

  resumenTemas         String?   @db.Text
  resumenAcuerdos      String?   @db.Text
  resumenProximosPasos String?   @db.Text

  estado EstadoMinutaExterna @default(ACTIVA)

  creadoPorId Int
  creadoPor   Usuario @relation("MinutaExternaCreador", fields: [creadoPorId], references: [id], onDelete: Restrict)

  cerradoPorId Int?
  cerradoPor   Usuario?  @relation("MinutaExternaCerrador", fields: [cerradoPorId], references: [id], onDelete: SetNull)
  cerradoAt    DateTime?

  fechaProgramada DateTime?

  tareas TareaExterna[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([creadoPorId])
  @@index([area])
  @@index([estado])
  @@index([createdAt])
}

/// Ítem de seguimiento dentro de una MinutaExterna.
model TareaExterna {
  id           Int          @id @default(autoincrement())
  descripcion  String       @db.Text
  area         Area         @default(DIRECCION_MBC)
  // departamento = la sub-área / línea (texto libre)
  departamento String?      @db.VarChar(100)

  estado           EstadoTarea? @default(PENDIENTE)
  prioridad        Prioridad?
  fechaVencimiento DateTime?
  completadoAt     DateTime?
  cerradoAt        DateTime?

  notificadoAt DateTime?

  pdfUrl String? @db.Text

  minutaExternaId Int
  minutaExterna   MinutaExterna @relation(fields: [minutaExternaId], references: [id], onDelete: Cascade)

  creadoPorId Int
  creadoPor   Usuario @relation("TareaExternaCreador", fields: [creadoPorId], references: [id], onDelete: Restrict)

  imagenes TareaExternaImagen[]
  notas    TareaExternaNota[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([minutaExternaId])
  @@index([estado])
  @@index([area])
  @@index([fechaVencimiento])
  @@index([creadoPorId])
}

model TareaExternaImagen {
  id       Int    @id @default(autoincrement())
  url      String @db.VarChar(500)
  publicId String @db.VarChar(300)
  orden    Int
  tipo     TipoImagen @default(CAPTURA)

  tareaExternaId Int
  tareaExterna   TareaExterna @relation(fields: [tareaExternaId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([tareaExternaId])
}

model TareaExternaNota {
  id        Int      @id @default(autoincrement())
  contenido String   @db.Text
  esEntrega Boolean  @default(false)

  tareaExternaId Int
  tareaExterna   TareaExterna @relation(fields: [tareaExternaId], references: [id], onDelete: Cascade)

  creadoPorId Int?
  creadoPor   Usuario? @relation("TareaExternaNotaCreador", fields: [creadoPorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([tareaExternaId])
}
