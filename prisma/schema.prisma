generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ───────────────────────────────────────────────

enum Rol {
  GERENCIA
  JEFE
  COORDINADOR
}

enum Estatus {
  ACTIVO
  INACTIVO
}

enum Area {
  DISENO
  DIRECCION_MBC
  DIRECCION_CFI
  DIRECCION_ADJUNTA
  DIRECCION_TIENDAS
}

enum Linea {
  CALZADO
  BOTA
  ROPA
  ACCESORIOS
}

enum Clasificacion {
  INVESTIGACION
  CORRECCION
  ANALISIS
  MUESTRA
  POLITICAS
  OTROS
}

enum Prioridad {
  BAJA
  MEDIA
  CRITICA
}

enum EstadoTarea {
  PENDIENTE
  EN_PROGRESO
  COMPLETADO
  CERRADO
}

enum EstadoAsignacion {
  PENDIENTE
  EN_PROGRESO
  COMPLETADO
}

enum EstadoMinuta {
  ABIERTA
  CERRADA
}

// ─── MODELOS ─────────────────────────────────────────────

model Usuario {
  id        Int     @id @default(autoincrement())
  nombre    String  @db.VarChar(100)
  username  String  @unique @db.VarChar(60)
  email     String? @unique @db.VarChar(150)
  password  String  @db.VarChar(255)
  imagen    String? @db.VarChar(500)

  rol     Rol     @default(COORDINADOR)
  estado  Estatus @default(ACTIVO)

  mustChangePassword Boolean @default(false)

  minutasCreadas  Minuta[]          @relation("MinutaCreador")
  tareasCreadas   Tarea[]           @relation("TareaCreador")
  asignaciones    TareaAsignacion[]
  historial       TareaHistorial[]
  bitacoras       Bitacora[]
  refreshTokens   RefreshToken[]
  resetTokens     PasswordResetToken[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([rol])
  @@index([estado])
}

model Minuta {
  id           Int          @id @default(autoincrement())
  titulo       String       @db.VarChar(200)
  lineaDefault Linea
  estado       EstadoMinuta @default(ABIERTA)
  fecha        DateTime     @default(now())

  creadoPorId Int
  creadoPor   Usuario @relation("MinutaCreador", fields: [creadoPorId], references: [id], onDelete: Restrict)

  tareas Tarea[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([creadoPorId])
  @@index([estado])
  @@index([fecha])
}

model Tarea {
  id          Int    @id @default(autoincrement())
  descripcion String @db.Text

  // Captura fase 1 (durante junta — todos opcionales)
  area      Area?
  prioridad Prioridad?
  linea     Linea?

  // Captura fase 2 (post-junta)
  clasificacion Clasificacion?
  fechaVencimiento DateTime?

  // Estado y fechas de control
  estado      EstadoTarea @default(PENDIENTE)
  completadoAt DateTime?  // Fecha que cuenta para métricas
  cerradoAt    DateTime?  // Fecha de cierre (no afecta métricas)

  // Flags de negocio (calculados por backend al crear/actualizar)
  isExternalArea Boolean @default(false) // true si area != DISENO
  isComplete     Boolean @default(false) // true cuando todos los campos requeridos están llenos

  minutaId Int?
  minuta   Minuta? @relation(fields: [minutaId], references: [id], onDelete: SetNull)

  creadoPorId Int
  creadoPor   Usuario @relation("TareaCreador", fields: [creadoPorId], references: [id], onDelete: Restrict)

  imagenes    TareaImagen[]
  asignaciones TareaAsignacion[]
  historial   TareaHistorial[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([minutaId])
  @@index([estado])
  @@index([area])
  @@index([isExternalArea])
  @@index([isComplete])
  @@index([fechaVencimiento])
  @@index([creadoPorId])
  @@index([minutaId, estado])
  @@index([area, estado])
}

model TareaAsignacion {
  id          Int              @id @default(autoincrement())
  estado      EstadoAsignacion @default(PENDIENTE)
  completadoAt DateTime?

  tareaId Int
  tarea   Tarea   @relation(fields: [tareaId], references: [id], onDelete: Cascade)

  usuarioId Int
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tareaId, usuarioId])
  @@index([tareaId])
  @@index([usuarioId])
  @@index([estado])
}

model TareaImagen {
  id       Int    @id @default(autoincrement())
  url      String @db.VarChar(500)
  publicId String @db.VarChar(300) // Cloudinary public ID para poder eliminar
  orden    Int    // 1, 2 o 3

  tareaId Int
  tarea   Tarea @relation(fields: [tareaId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([tareaId])
}

model TareaHistorial {
  id        Int     @id @default(autoincrement())
  campo     String  @db.VarChar(100)
  valorAntes String? @db.Text
  valorDespues String? @db.Text

  tareaId Int
  tarea   Tarea   @relation(fields: [tareaId], references: [id], onDelete: Cascade)

  usuarioId Int
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@index([tareaId])
  @@index([usuarioId])
}

// ─── INFRAESTRUCTURA (Reutilizados del sistema anterior) ──

model Bitacora {
  id       Int     @id @default(autoincrement())
  accion   String  @db.VarChar(100)
  detalles String? @db.Text

  usuarioId Int?
  usuario   Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([usuarioId])
  @@index([createdAt])
}

model RefreshToken {
  id          String  @id @default(uuid())
  hashedToken String  @db.VarChar(255)

  usuarioId Int
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  revoked   Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([usuarioId])
}

model PasswordResetToken {
  id        String  @id @default(uuid())
  token     String  @unique @db.VarChar(255)
  usuarioId Int
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([usuarioId])
}