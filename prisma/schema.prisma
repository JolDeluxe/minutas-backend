generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ───────────────────────────────────────────────

enum Rol {
  ADMIN
  GERENCIA
  JEFE
  COORDINADOR
}

enum Departamento {
  DISENO
  MARKETING
}

enum Estatus {
  ACTIVO
  INACTIVO
}

enum Area {
  DISENO
  MARKETING
  DIRECCION_MBC
  DIRECCION_CFI
  DIRECCION_ADJUNTA
  DIRECCION_TIENDAS
}

enum Linea {
  CALZADO
  BOTA
  ROPA
  ACCESORIOS
}

enum Clasificacion {
  IDEA
  INVESTIGACION
  CORRECCION
  ANALISIS
  MUESTRA
  POLITICAS
  OTROS
}

enum Prioridad {
  BAJA
  MEDIA
  ALTA
  CRITICA
}

enum EstadoConceptual {
  CAPTURADO
  EN_REVISION
  CERRADO
  DESCARTADO
}

enum EstadoOperativo {
  PENDIENTE
  EN_PROGRESO
  COMPLETADO
}

enum EstadoTarea {
  PENDIENTE
  EN_PROGRESO
  COMPLETADO
  CERRADO
}

enum TipoAsignacion {
  SEGUIMIENTO
  EJECUTOR
}

enum EstadoAsignacion {
  PENDIENTE
  EN_PROGRESO
  COMPLETADO
}

enum EstadoMinuta {
  PROGRAMADA
  ACTIVA
  EN_REVISION
  CERRADA
  CANCELADA
}

enum TipoEventoEntrada {
  CAPTURA
  ACTUALIZACION
  REVISION
  FORMALIZACION
  ASIGNACION
  CAMBIO_ESTADO
  CIERRE
  DESCARTE
  COMENTARIO
  ADJUNTO
}

// ─── MODELOS ─────────────────────────────────────────────

model Usuario {
  id       Int     @id @default(autoincrement())
  nombre   String  @db.VarChar(100)
  username String  @unique @db.VarChar(60)
  email    String? @unique @db.VarChar(150)
  password String  @db.VarChar(255)
  imagen   String? @db.VarChar(500)

  rol    Rol     @default(COORDINADOR)
  estado Estatus @default(ACTIVO)

  departamento Departamento?
  linea        Linea?

  dummyClasificacion Clasificacion?

  mustChangePassword Boolean @default(false)

  minutasCreadas        Minuta[]             @relation("MinutaCreador")
  minutasCerradas       Minuta[]             @relation("MinutaCerrador")
  minutasCanceladas     Minuta[]             @relation("MinutaCancelador")
  tareasCreadas         Tarea[]              @relation("TareaCreador")
  tareasFormalizadas    Tarea[]              @relation("TareaFormalizador")
  asignaciones          TareaAsignacion[]
  asignacionesCreadas   TareaAsignacion[]    @relation("TareaAsignador")
  historial             TareaHistorial[]
  notasGeneralesCreadas NotaGeneral[]        @relation("NotaGeneralCreador")
  notasEntradaCreadas   TareaNota[]          @relation("TareaNotaCreador")
  bitacoras             Bitacora[]
  refreshTokens         RefreshToken[]
  resetTokens           PasswordResetToken[]
  notificaciones        Notificacion[]
  pushSubscriptions     PushSubscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([rol])
  @@index([estado])
}

model Minuta {
  id           Int          @id @default(autoincrement())
  titulo       String       @db.VarChar(200)
  lineaDefault Linea
  estado       EstadoMinuta @default(PROGRAMADA)

  fechaProgramada DateTime
  fechaRealizada  DateTime?

  creadoPorId Int
  creadoPor   Usuario @relation("MinutaCreador", fields: [creadoPorId], references: [id], onDelete: Restrict)

  cerradoPorId Int?
  cerradoPor   Usuario?  @relation("MinutaCerrador", fields: [cerradoPorId], references: [id], onDelete: SetNull)
  cerradoAt    DateTime?

  canceladoPorId Int?
  canceladoPor   Usuario?  @relation("MinutaCancelador", fields: [canceladoPorId], references: [id], onDelete: SetNull)
  canceladoAt    DateTime?

  minutaAnteriorId  Int?
  minutaAnterior    Minuta?  @relation("SiguienteAnterior", fields: [minutaAnteriorId], references: [id])
  minutasSiguientes Minuta[] @relation("SiguienteAnterior")

  tareas         Tarea[]
  notasGenerales NotaGeneral[] // <--- SE AGREGAN LOS POST-ITS A LA MINUTA

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([creadoPorId])
  @@index([cerradoPorId])
  @@index([estado])
  @@index([fechaProgramada])
  @@index([fechaRealizada])
  @@index([lineaDefault])
  @@index([minutaAnteriorId])
}

// <--- NUEVO MODELO: POST-ITS GENERALES DE LA JUNTA
model NotaGeneral {
  id        Int     @id @default(autoincrement())
  contenido String  @db.Text
  imagenUrl String? @db.VarChar(500)
  publicId  String? @db.VarChar(300) // Para Cloudinary

  minutaId Int
  minuta   Minuta @relation(fields: [minutaId], references: [id], onDelete: Cascade)

  creadoPorId Int?
  creadoPor   Usuario? @relation("NotaGeneralCreador", fields: [creadoPorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([minutaId])
  @@index([creadoPorId])
}

/// Entrada Organizacional.
/// Se conserva el nombre tecnico `Tarea` por compatibilidad con los modulos actuales,
/// pero conceptualmente representa ideas, acuerdos, observaciones, seguimientos y
/// trabajo formalizado dentro de una minuta.
model Tarea {
  id          Int    @id @default(autoincrement())
  descripcion String @db.Text

  departamento Departamento @default(DISENO)

  // Fase 1: captura ligera durante junta.
  area                Area      @default(DISENO)
  linea               Linea?
  clasificacion       String
  fechaSeguimiento    DateTime?
  requiereSeguimiento Boolean   @default(false)

  // Fase 2: organizacion post-junta and formalizacion progresiva.
  estadoConceptual EstadoConceptual @default(CAPTURADO)
  formalizada      Boolean          @default(false)
  formalizadoAt    DateTime?
  formalizadoPorId Int?
  formalizadoPor   Usuario?         @relation("TareaFormalizador", fields: [formalizadoPorId], references: [id], onDelete: SetNull)

  // Solo aplica a entradas formalizadas como trabajo operativo real.
  prioridad        Prioridad?
  estadoOperativo  EstadoOperativo?
  fechaVencimiento DateTime?
  completadoAt     DateTime? // Fecha que cuenta para métricas.

  // Compatibilidad temporal con el backend actual.
  estado    EstadoTarea @default(PENDIENTE)
  cerradoAt DateTime? // Fecha de cierre (no afecta métricas)

  // Flags de negocio legacy (calculados por backend al crear/actualizar)
  capturaCompleta Boolean @default(false)
  isExternalArea  Boolean @default(false)
  pdfUrl          String? @db.Text

  minutaId Int?
  minuta   Minuta? @relation(fields: [minutaId], references: [id], onDelete: SetNull)

  creadoPorId Int
  creadoPor   Usuario @relation("TareaCreador", fields: [creadoPorId], references: [id], onDelete: Restrict)

  imagenes       TareaImagen[]
  asignaciones   TareaAsignacion[]
  historial      TareaHistorial[]
  notas          TareaNota[]
  notificaciones Notificacion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([minutaId])
  @@index([estado])
  @@index([estadoConceptual])
  @@index([estadoOperativo])
  @@index([area])
  @@index([departamento])
  @@index([isExternalArea])
  @@index([capturaCompleta])
  @@index([formalizada])
  @@index([requiereSeguimiento])
  @@index([fechaSeguimiento])
  @@index([fechaVencimiento])
  @@index([creadoPorId])
  @@index([formalizadoPorId])
  @@index([minutaId, estado])
  @@index([formalizada, estadoOperativo])
  @@index([fechaSeguimiento, estadoConceptual])
  @@index([area, estado])
}

// <--- NUEVO MODELO: ANEXOS DENTRO DE UNA TAREA
model TareaNota {
  id        Int     @id @default(autoincrement())
  contenido String  @db.Text
  imagenUrl String? @db.VarChar(500)
  publicId  String? @db.VarChar(300) // Para Cloudinary

  tareaId Int
  tarea   Tarea @relation(fields: [tareaId], references: [id], onDelete: Cascade)

  creadoPorId Int?
  creadoPor   Usuario? @relation("TareaNotaCreador", fields: [creadoPorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([tareaId])
  @@index([creadoPorId])
}

model TareaAsignacion {
  id           Int              @id @default(autoincrement())
  tipo         TipoAsignacion   @default(EJECUTOR)
  estado       EstadoAsignacion @default(PENDIENTE)
  completadoAt DateTime?

  tareaId Int
  tarea   Tarea @relation(fields: [tareaId], references: [id], onDelete: Cascade)

  usuarioId Int
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  asignadoPorId Int?
  asignadoPor   Usuario? @relation("TareaAsignador", fields: [asignadoPorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tareaId, usuarioId, tipo])
  @@index([tareaId])
  @@index([usuarioId])
  @@index([asignadoPorId])
  @@index([tipo])
  @@index([estado])
}

model TareaImagen {
  id       Int    @id @default(autoincrement())
  url      String @db.VarChar(500)
  publicId String @db.VarChar(300) // Cloudinary public ID para poder eliminar
  orden    Int // 1, 2 o 3

  tareaId Int
  tarea   Tarea @relation(fields: [tareaId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([tareaId])
}

model TareaHistorial {
  id           Int               @id @default(autoincrement())
  tipo         TipoEventoEntrada @default(ACTUALIZACION)
  campo        String            @db.VarChar(100)
  valorAntes   String?           @db.Text
  valorDespues String?           @db.Text
  metadata     Json?

  tareaId Int
  tarea   Tarea @relation(fields: [tareaId], references: [id], onDelete: Cascade)

  usuarioId Int
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@index([tareaId])
  @@index([usuarioId])
  @@index([tipo])
}

// ─── INFRAESTRUCTURA (Reutilizados del sistema anterior) ──

model Bitacora {
  id       Int     @id @default(autoincrement())
  accion   String  @db.VarChar(100)
  detalles String? @db.Text

  usuarioId Int?
  usuario   Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([usuarioId])
  @@index([createdAt])
}

model RefreshToken {
  id          String @id @default(uuid())
  hashedToken String @db.VarChar(255)

  usuarioId Int
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  revoked   Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([usuarioId])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  token     String   @unique @db.VarChar(255)
  usuarioId Int
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([usuarioId])
}

// ─── NOTIFICACIONES ──────────────────────────────────────

enum TipoNotificacion {
  ENTRADA_CAPTURADA
  ENTRADA_FORMALIZADA
  ENTRADA_DESCARTADA
  SEGUIMIENTO_ASIGNADO
  SEGUIMIENTO_PROXIMO
  NUEVAS_TAREAS
  TAREA_ASIGNADA
  TAREA_COMPLETADA
  TAREA_CERRADA
  TAREA_MODIFICADA
  REVISION_PENDIENTE
  VENCIMIENTO_PROXIMO
  LINEA_CAMBIADA
}

model Notificacion {
  id        Int              @id @default(autoincrement())
  tipo      TipoNotificacion
  titulo    String           @db.VarChar(150)
  cuerpo    String           @db.Text
  leida     Boolean          @default(false)
  accionada Boolean          @default(false)

  usuarioId Int
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  tareaId Int?
  tarea   Tarea? @relation(fields: [tareaId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([usuarioId])
  @@index([leida])
  @@index([tareaId])
}

model PushSubscription {
  id       Int    @id @default(autoincrement())
  endpoint String @unique @db.VarChar(500)
  p256dh   String @db.VarChar(300)
  auth     String @db.VarChar(100)

  usuarioId    Int
  usuario      Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  lastSuccess  DateTime?
  failureCount Int       @default(0)

  createdAt DateTime @default(now())

  @@index([usuarioId])
}
